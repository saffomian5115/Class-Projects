<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="T_Txx3Xaxb4ICrfqFrLV">
    <mxGraphModel dx="1717" dy="-63" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam actorStyle awesome\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #F5EEFF\n  BorderColor #7C3AED\n  FontColor #1A2235\n  FontSize 11\n}\nskinparam actor {\n  BackgroundColor #EDE0FF\n  BorderColor #7C3AED\n  FontColor #1A2235\n  FontSize 12\n  FontStyle bold\n}\nskinparam package {\n  BackgroundColor #FAF7FF\n  BorderColor #C4A8F0\n  FontColor #1A2235\n  FontStyle bold\n}\nskinparam arrow {\n  Color #7C3AED\n  FontColor #7C3AED\n  FontSize 10\n}\n\nleft to right direction\n\n&#39; --- Actors ---\nactor \&quot;Admin\&quot;           as Admin   #LightSteelBlue\nactor \&quot;Teacher\&quot;         as Teacher #PaleGreen\nactor \&quot;Student\&quot;         as Student #LightSalmon\nactor \&quot;Dlib AI Engine\&quot;  as Dlib    #Plum\nactor \&quot;Gate Scanner\&quot;    as Gate    #LightGray\n\nrectangle \&quot;Face Recognition Module\&quot; {\n\n  &#39; --- TOP ROW ---\n  package \&quot;Face Enrollment\&quot; as P1 {\n    usecase \&quot;Enroll Student\\nFace (Admin)\&quot; as UC_AdminEnroll\n    usecase \&quot;Enroll Own\\nFace (Self)\&quot; as UC_SelfEnroll\n    usecase \&quot;Capture Face\\nImage (Base64)\&quot; as UC_Capture\n    usecase \&quot;Extract 128-d\\nDlib Embedding\&quot; as UC_Extract\n    usecase \&quot;Store Embedding\\nin Database\&quot; as UC_Store\n  }\n\n  package \&quot;Face Login\&quot; as P2 {\n    usecase \&quot;Face Recognition\\nLogin\&quot; as UC_FaceLogin\n    usecase \&quot;Compare Face\\nwith All Embeddings\&quot; as UC_Compare\n    usecase \&quot;Generate JWT\\nTokens on Match\&quot; as UC_JWT\n    usecase \&quot;Reject Unrecognized\\nFace\&quot; as UC_Reject\n  }\n\n  &#39; Force P2 to the right of P1\n  P1 -right[hidden]- P2\n\n  &#39; --- BOTTOM ROW ---\n  package \&quot;Lecture Attendance\&quot; as P3 {\n    usecase \&quot;Teacher Marks\\nAttendance Manually\&quot; as UC_Manual\n    usecase \&quot;Update Attendance\\nSummary &amp; %\&quot; as UC_Summary\n    usecase \&quot;Trigger Short\\nAttendance Alert\&quot; as UC_Alert\n  }\n\n  package \&quot;Campus Gate Attendance\&quot; as P4 {\n    usecase \&quot;Gate Camera\\nCaptures Face\&quot; as UC_GateCapture\n    usecase \&quot;Recognize Student\\at Gate\&quot; as UC_GateRecog\n    usecase \&quot;Log Campus\\nEntry / Exit\&quot; as UC_GateLog\n    usecase \&quot;Filter Duplicate\\nEntries (5 min)\&quot; as UC_Duplicate\n    usecase \&quot;Manual Override\\nby Admin\&quot; as UC_Override\n  }\n\n  &#39; Position Bottom Row below Top Row\n  P1 -[hidden]down- P3\n  P3 -right[hidden]- P4\n}\n\n&#39; --- Associations ---\nAdmin --&gt; UC_AdminEnroll\nAdmin --&gt; UC_Override\n\nTeacher --&gt; UC_Manual\nTeacher --&gt; UC_Summary\n\nStudent --&gt; UC_SelfEnroll\nStudent --&gt; UC_FaceLogin\n\nDlib --&gt; UC_Extract\nDlib --&gt; UC_Compare\nDlib --&gt; UC_GateRecog\n\nGate --&gt; UC_GateCapture\nGate --&gt; UC_GateLog\n\n&#39; --- Include / Extend (Logic Flow) ---\nUC_AdminEnroll  .&gt; UC_Capture   : &lt;&lt;include&gt;&gt;\nUC_SelfEnroll   .&gt; UC_Capture   : &lt;&lt;include&gt;&gt;\nUC_Capture      .&gt; UC_Extract   : &lt;&lt;include&gt;&gt;\nUC_Extract      .&gt; UC_Store     : &lt;&lt;include&gt;&gt;\n\nUC_FaceLogin    .&gt; UC_Compare   : &lt;&lt;include&gt;&gt;\nUC_Compare      .&gt; UC_JWT       : &lt;&lt;extend&gt;&gt;\nUC_Compare      .&gt; UC_Reject    : &lt;&lt;extend&gt;&gt;\n\nUC_GateCapture  .&gt; UC_GateRecog : &lt;&lt;include&gt;&gt;\nUC_GateRecog    .&gt; UC_GateLog   : &lt;&lt;include&gt;&gt;\nUC_GateLog      .&gt; UC_Duplicate : &lt;&lt;include&gt;&gt;\nUC_Override     .&gt; UC_GateLog   : &lt;&lt;extend&gt;&gt;\n\nUC_Manual        .&gt; UC_Summary   : &lt;&lt;include&gt;&gt;\nUC_Summary       .&gt; UC_Alert     : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="14pVjtuajESJFR7WagT--21">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
