  <diagram name="Page-1" id="T_Txx3Xaxb4ICrfqFrLV">
    <mxGraphModel dx="2575" dy="455" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam actorStyle awesome\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #FFF3EE\n  BorderColor #E8611A\n  FontColor #1A2235\n  FontSize 11\n}\nskinparam actor {\n  BackgroundColor #FFE0D0\n  BorderColor #E8611A\n  FontColor #1A2235\n  FontSize 12\n  FontStyle bold\n}\nskinparam package {\n  BackgroundColor #FFFAF8\n  BorderColor #F0A882\n  FontColor #1A2235\n  FontStyle bold\n}\nskinparam arrow {\n  Color #E8611A\n  FontColor #E8611A\n  FontSize 10\n}\n\nleft to right direction\n\nactor \&quot;Student\&quot; as Student #LightSalmon\n\nrectangle \&quot;AI-Driven Smart LMS — Student Portal\&quot; {\n\n  &#39; --- ROW 1 ---\n  package \&quot;Authentication\&quot; as P1 {\n    usecase \&quot;Login (Email /\\nFace Recognition)\&quot; as UC_Login\n    usecase \&quot;Update Profile\&quot; as UC_Profile\n  }\n\n  package \&quot;Course &amp; Enrollment\&quot; as P2 {\n    usecase \&quot;View Enrolled\\nCourses\&quot; as UC_Courses\n    usecase \&quot;View Course\\nDetails &amp; CLOs\&quot; as UC_Details\n  }\n\n  P1 -right[hidden]- P2\n\n  &#39; --- ROW 2 ---\n  package \&quot;Attendance\&quot; as P3 {\n    usecase \&quot;View Attendance\\nper Course\&quot; as UC_Att\n    usecase \&quot;Receive Shortage\\nAlert\&quot; as UC_Alert\n  }\n\n  package \&quot;Assessment\&quot; as P4 {\n    usecase \&quot;Submit\\nAssignment\&quot; as UC_Submit\n    usecase \&quot;Attempt\\nQuiz\&quot; as UC_Quiz\n    usecase \&quot;View Exam\\nResults &amp; Grades\&quot; as UC_Results\n  }\n\n  P1 -[hidden]down- P3\n  P3 -right[hidden]- P4\n\n  &#39; --- ROW 3 ---\n  package \&quot;AI-Powered Features\&quot; as P5 {\n    usecase \&quot;Use AI Chatbot\\n(Gemini + RAG)\&quot; as UC_Chatbot\n    usecase \&quot;Generate AI\\nPractice Quiz\&quot; as UC_AIQuiz\n    usecase \&quot;View Performance\\nAnalytics\&quot; as UC_Analytics\n    usecase \&quot;View Class\\nLeaderboard\&quot; as UC_Leader\n  }\n\n  package \&quot;Fee Management\&quot; as P6 {\n    usecase \&quot;View Fee\\nVouchers\&quot; as UC_Fee\n    usecase \&quot;Check Payment\\nStatus\&quot; as UC_PayStatus\n  }\n\n  P3 -[hidden]down- P5\n  P5 -right[hidden]- P6\n\n  &#39; --- ROW 4 (Bottom) ---\n  package \&quot;Communication\&quot; as P7 {\n    usecase \&quot;View Announcements\\n&amp; Notices\&quot; as UC_Ann\n    usecase \&quot;Participate in\\nCourse Chat\&quot; as UC_Chat\n  }\n\n  P5 -[hidden]down- P7\n}\n\n&#39; --- Associations ---\nStudent --&gt; UC_Login\nStudent --&gt; UC_Profile\nStudent --&gt; UC_Courses\nStudent --&gt; UC_Details\nStudent --&gt; UC_Att\nStudent --&gt; UC_Alert\nStudent --&gt; UC_Submit\nStudent --&gt; UC_Quiz\nStudent --&gt; UC_Results\nStudent --&gt; UC_Chatbot\nStudent --&gt; UC_AIQuiz\nStudent --&gt; UC_Analytics\nStudent --&gt; UC_Leader\nStudent --&gt; UC_Fee\nStudent --&gt; UC_PayStatus\nStudent --&gt; UC_Ann\nStudent --&gt; UC_Chat\n\n&#39; --- Include / Extend ---\nUC_Login      .&gt; UC_Courses   : &lt;&lt;include&gt;&gt;\nUC_Att         .&gt; UC_Alert     : &lt;&lt;extend&gt;&gt;\nUC_AIQuiz      .&gt; UC_Quiz      : &lt;&lt;extend&gt;&gt;\nUC_Leader      .&gt; UC_Analytics : &lt;&lt;include&gt;&gt;\nUC_PayStatus   .&gt; UC_Fee       : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="14pVjtuajESJFR7WagT--21">
