        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam actorStyle awesome\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EEF4FF\n  BorderColor #3A6BD4\n  FontColor #1A2235\n  FontSize 11\n}\nskinparam actor {\n  BackgroundColor #D6E4FF\n  BorderColor #1D4ED8\n  FontColor #1A2235\n  FontSize 12\n  FontStyle bold\n}\nskinparam package {\n  BackgroundColor #F8FBFF\n  BorderColor #93B4E8\n  FontColor #1A2235\n  FontStyle bold\n}\nskinparam arrow {\n  Color #3A6BD4\n  FontColor #3A6BD4\n  FontSize 10\n}\n\nleft to right direction\n\nactor \&quot;Admin\&quot; as Admin #LightSteelBlue\n\nrectangle \&quot;AI-Driven Smart LMS — Admin Portal\&quot; {\n\n  &#39; --- ROW 1 (3 Columns) ---\n  package \&quot;Authentication\&quot; as P1 {\n    usecase \&quot;Login\&quot; as UC_Login\n    usecase \&quot;Update Profile\&quot; as UC_Profile\n  }\n\n  package \&quot;User Management\&quot; as P2 {\n    usecase \&quot;Create / Edit\\nStudents &amp; Teachers\&quot; as UC_Users\n    usecase \&quot;Activate / Deactivate\\nUser Account\&quot; as UC_Toggle\n    usecase \&quot;Enroll Student\\nFace (Dlib)\&quot; as UC_Face\n  }\n\n  package \&quot;Academic Structure\&quot; as P3 {\n    usecase \&quot;Manage Departments\\n&amp; Programs\&quot; as UC_Dept\n    usecase \&quot;Manage Courses\\n&amp; CLOs\&quot; as UC_Course\n    usecase \&quot;Manage Semesters\\n&amp; Offerings\&quot; as UC_Sem\n  }\n\n  P1 -right[hidden]- P2\n  P2 -right[hidden]- P3\n\n  &#39; --- ROW 2 (3 Columns) ---\n  package \&quot;Enrollment Management\&quot; as P4 {\n    usecase \&quot;Enroll Student\\nin Program &amp; Courses\&quot; as UC_Enroll\n    usecase \&quot;Drop Enrollment\\n&amp; Enter Grades\&quot; as UC_Drop\n  }\n\n  package \&quot;Attendance Management\&quot; as P5 {\n    usecase \&quot;View Attendance\\nReports\&quot; as UC_AttRpt\n    usecase \&quot;View Campus Gate\\nAttendance\&quot; as UC_GateAtt\n    usecase \&quot;Manual Attendance\\nOverride\&quot; as UC_Override\n  }\n\n  package \&quot;Fee Management\&quot; as P6 {\n    usecase \&quot;Define Fee\\nStructure\&quot; as UC_FeeStr\n    usecase \&quot;Generate Fee\\nVouchers (Bulk)\&quot; as UC_Voucher\n    usecase \&quot;Record Payment\\n&amp; Apply Fine\&quot; as UC_Payment\n  }\n\n  P1 -[hidden]down- P4\n  P4 -right[hidden]- P5\n  P5 -right[hidden]- P6\n\n  &#39; --- ROW 3 (3 Columns) ---\n  package \&quot;Campus Gate Management\&quot; as P7 {\n    usecase \&quot;Manage Gates\\n&amp; Cameras\&quot; as UC_Gates\n    usecase \&quot;Set Gate\\nSchedules\&quot; as UC_Sched\n    usecase \&quot;Operate Gate\\nFace Scanner\&quot; as UC_Scanner\n  }\n\n  package \&quot;AI Analytics\&quot; as P8 {\n    usecase \&quot;Calculate &amp; View\\nStudent Analytics\&quot; as UC_Analytics\n    usecase \&quot;View Leaderboard\\n&amp; At-Risk Students\&quot; as UC_Leader\n  }\n\n  package \&quot;Chatbot &amp; API Keys\&quot; as P9 {\n    usecase \&quot;Manage Chatbot\\nFAQs\&quot; as UC_FAQ\n    usecase \&quot;Manage Gemini\\nAPI Keys\&quot; as UC_Keys\n  }\n\n  P4 -[hidden]down- P7\n  P7 -right[hidden]- P8\n  P8 -right[hidden]- P9\n\n  &#39; --- ROW 4 (Bottom Center) ---\n  package \&quot;Communication\&quot; as P10 {\n    usecase \&quot;Post Announcements\\n&amp; Notices\&quot; as UC_Ann\n  }\n  \n  P8 -[hidden]down- P10\n}\n\n&#39; --- Associations ---\nAdmin --&gt; UC_Login\nAdmin --&gt; UC_Profile\nAdmin --&gt; UC_Users\nAdmin --&gt; UC_Toggle\nAdmin --&gt; UC_Face\nAdmin --&gt; UC_Dept\nAdmin --&gt; UC_Course\nAdmin --&gt; UC_Sem\nAdmin --&gt; UC_Enroll\nAdmin --&gt; UC_Drop\nAdmin --&gt; UC_AttRpt\nAdmin --&gt; UC_GateAtt\nAdmin --&gt; UC_Override\nAdmin --&gt; UC_FeeStr\nAdmin --&gt; UC_Voucher\nAdmin --&gt; UC_Payment\nAdmin --&gt; UC_Gates\nAdmin --&gt; UC_Sched\nAdmin --&gt; UC_Scanner\nAdmin --&gt; UC_Ann\nAdmin --&gt; UC_Analytics\nAdmin --&gt; UC_Leader\nAdmin --&gt; UC_FAQ\nAdmin --&gt; UC_Keys\n\n&#39; --- Include / Extend ---\nUC_Voucher  .&gt; UC_FeeStr   : &lt;&lt;include&gt;&gt;\nUC_Payment  .&gt; UC_Voucher  : &lt;&lt;include&gt;&gt;\nUC_Scanner  .&gt; UC_Override : &lt;&lt;extend&gt;&gt;\nUC_Leader   .&gt; UC_Analytics : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="14pVjtuajESJFR7WagT--21">
