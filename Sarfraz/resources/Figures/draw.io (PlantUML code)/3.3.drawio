<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="T_Txx3Xaxb4ICrfqFrLV">
    <mxGraphModel dx="1030" dy="-478" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam actorStyle awesome\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EFFFEF\n  BorderColor #22a06b\n  FontColor #1A2235\n  FontSize 11\n}\nskinparam actor {\n  BackgroundColor #C8F0DC\n  BorderColor #22a06b\n  FontColor #1A2235\n  FontSize 12\n  FontStyle bold\n}\nskinparam package {\n  BackgroundColor #F6FFF9\n  BorderColor #7DDBB0\n  FontColor #1A2235\n  FontStyle bold\n}\nskinparam arrow {\n  Color #22a06b\n  FontColor #22a06b\n  FontSize 10\n}\n\n&#39; Layout strategy: Forced Grid\nleft to right direction\n\nactor \&quot;Teacher\&quot; as Teacher #PaleGreen\n\nrectangle \&quot;AI-Driven Smart LMS — Teacher Portal\&quot; {\n\n  &#39; --- ROW 1 ---\n  package \&quot;Authentication\&quot; as P1 {\n    usecase \&quot;Login\&quot; as UC_Login\n    usecase \&quot;Update Profile\&quot; as UC_Profile\n  }\n\n  package \&quot;Course Management\&quot; as P2 {\n    usecase \&quot;View Assigned\\nCourses\&quot; as UC_Courses\n    usecase \&quot;View Enrolled\\nStudents\&quot; as UC_Students\n  }\n  \n  &#39; Force P2 to the right of P1\n  P1 -right[hidden]- P2\n\n  &#39; --- ROW 2 ---\n  package \&quot;Attendance Management\&quot; as P3 {\n    usecase \&quot;Create Lecture\\nSession\&quot; as UC_Session\n    usecase \&quot;Mark Bulk\\nAttendance\&quot; as UC_MarkAtt\n    usecase \&quot;View Attendance\\nReport\&quot; as UC_AttRpt\n    usecase \&quot;View Short\\nAttendance Students\&quot; as UC_Short\n  }\n\n  package \&quot;Assessment Management\&quot; as P4 {\n    usecase \&quot;Create / Manage\\nAssignments\&quot; as UC_Assign\n    usecase \&quot;Grade Student\\nSubmissions\&quot; as UC_Grade\n    usecase \&quot;Run Plagiarism\\nCheck\&quot; as UC_Plag\n    usecase \&quot;Create / Manage\\nQuizzes\&quot; as UC_Quiz\n    usecase \&quot;Generate AI Quiz\\n(Gemini)\&quot; as UC_AIQuiz\n    usecase \&quot;Create Exam &amp;\\nEnter Results\&quot; as UC_Exam\n  }\n\n  &#39; Position Row 2 below Row 1\n  P1 -[hidden]down- P3\n  P3 -right[hidden]- P4\n\n  &#39; --- ROW 3 ---\n  package \&quot;Analytics &amp; Reports\&quot; as P5 {\n    usecase \&quot;View Class\\nLeaderboard\&quot; as UC_Leader\n    usecase \&quot;View At-Risk\\nStudents\&quot; as UC_AtRisk\n    usecase \&quot;Calculate Student\\nAnalytics\&quot; as UC_Calc\n  }\n\n  package \&quot;Communication\&quot; as P6 {\n    usecase \&quot;View Announcements\\n&amp; Notices\&quot; as UC_Ann\n    usecase \&quot;Manage Course\\nChat Group\&quot; as UC_Chat\n  }\n\n  &#39; Position Row 3 below Row 2\n  P3 -[hidden]down- P5\n  P5 -right[hidden]- P6\n}\n\n&#39; --- Associations (Optimized for Grid) ---\n&#39; Grouping links to prevent arrow-spaghetti\nTeacher --&gt; UC_Login\nTeacher --&gt; UC_Profile\n\nTeacher --&gt; UC_Courses\nTeacher --&gt; UC_Students\n\nTeacher --&gt; UC_Session\nTeacher --&gt; UC_MarkAtt\nTeacher --&gt; UC_AttRpt\nTeacher --&gt; UC_Short\n\nTeacher --&gt; UC_Assign\nTeacher --&gt; UC_Grade\nTeacher --&gt; UC_Plag\nTeacher --&gt; UC_Quiz\nTeacher --&gt; UC_AIQuiz\nTeacher --&gt; UC_Exam\n\nTeacher --&gt; UC_Leader\nTeacher --&gt; UC_AtRisk\nTeacher --&gt; UC_Calc\n\nTeacher --&gt; UC_Ann\nTeacher --&gt; UC_Chat\n\n&#39; --- Include / Extend ---\nUC_MarkAtt  .&gt; UC_Session  : &lt;&lt;include&gt;&gt;\nUC_AIQuiz    .&gt; UC_Quiz     : &lt;&lt;extend&gt;&gt;\nUC_Plag      .&gt; UC_Grade    : &lt;&lt;extend&gt;&gt;\nUC_AtRisk    .&gt; UC_Leader   : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="14pVjtuajESJFR7WagT--21">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
