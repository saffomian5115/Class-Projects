        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam actorStyle awesome\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #F0F4FF\n  BorderColor #3A6BD4\n  FontColor #1A2235\n  FontSize 11\n}\nskinparam actor {\n  BackgroundColor #E8F0FE\n  BorderColor #1D4ED8\n  FontColor #1A2235\n  FontSize 11\n  FontStyle bold\n}\nskinparam package {\n  BackgroundColor #FAFCFF\n  BorderColor #93B4E8\n  FontColor #1A2235\n  FontStyle bold\n}\nskinparam arrow {\n  Color #3A6BD4\n  FontColor #3A6BD4\n  FontSize 10\n}\n\nleft to right direction\n\n&#39; --- Actors Left Side ---\nactor \&quot;Admin\&quot; as Admin #LightSteelBlue\nactor \&quot;Gate Scanner\&quot; as Gate #LightGray\n\nrectangle \&quot;AI-Driven Smart LMS\&quot; {\n\n  &#39; Column 1\n  package \&quot;Authentication\&quot; as P1 {\n    usecase \&quot;Login (Email /\\nFace Recognition)\&quot; as UC_Login\n  }\n\n  package \&quot;Academic Management\&quot; as P2 {\n    usecase \&quot;Manage Departments,\\nPrograms &amp; Courses\&quot; as UC_Academic\n    usecase \&quot;Manage Semesters\\n&amp; Offerings\&quot; as UC_Offer\n    usecase \&quot;Manage Enrollments\&quot; as UC_Enroll\n  }\n\n  package \&quot;Attendance System\&quot; as P3 {\n    usecase \&quot;Mark Lecture\\nAttendance (Level 1)\&quot; as UC_LecAtt\n    usecase \&quot;Campus Gate\\nFace Scan (Level 2)\&quot; as UC_GateScan\n    usecase \&quot;View Attendance\\nReports &amp; Alerts\&quot; as UC_AttRpt\n  }\n\n  package \&quot;Fee Management\&quot; as P4 {\n    usecase \&quot;Generate Vouchers\\n&amp; Record Payments\&quot; as UC_Fee\n  }\n\n  &#39; Column 2\n  package \&quot;Assessment\&quot; as P5 {\n    usecase \&quot;Create &amp; Submit\\nAssignments\&quot; as UC_Assign\n    usecase \&quot;Create &amp; Take\\nQuizzes\&quot; as UC_Quiz\n    usecase \&quot;Create Exams &amp;\\nEnter Results\&quot; as UC_Exam\n  }\n\n  package \&quot;AI-Powered Features\&quot; as P6 {\n    usecase \&quot;Face Recognition\\nLogin &amp; Attendance\&quot; as UC_Face\n    usecase \&quot;AI Chatbot\\n(Gemini + RAG)\&quot; as UC_Chatbot\n    usecase \&quot;Generate AI Quiz\\n(Gemini)\&quot; as UC_AIQuiz\n    usecase \&quot;Plagiarism\\nDetection\&quot; as UC_Plag\n    usecase \&quot;Student Analytics\\n&amp; Leaderboard\&quot; as UC_Analytics\n  }\n\n  package \&quot;Communication\&quot; as P7 {\n    usecase \&quot;Announcements,\\nNotices &amp; Chat\&quot; as UC_Comm\n  }\n\n  &#39; Layout Alignment\n  P1 -right[hidden]- P5\n  P2 -right[hidden]- P6\n  P3 -right[hidden]- P7\n  P1 -[hidden]down- P2\n  P2 -[hidden]down- P3\n  P3 -[hidden]down- P4\n}\n\n&#39; --- Actors Right Side ---\nactor \&quot;Teacher\&quot; as Teacher #PaleGreen\nactor \&quot;Student\&quot; as Student #LightSalmon\nactor \&quot;AI Engine\\n(Gemini+Dlib+FAISS)\&quot; as AI #Plum\n\n&#39; --- Associations (Strategic Placement) ---\nAdmin --&gt; UC_Login\nAdmin --&gt; UC_Academic\nAdmin --&gt; UC_Offer\nAdmin --&gt; UC_Enroll\nAdmin --&gt; UC_AttRpt\nAdmin --&gt; UC_Fee\nAdmin --&gt; UC_Comm\nAdmin --&gt; UC_Analytics\nAdmin --&gt; UC_Face\n\nGate --&gt; UC_GateScan\n\nTeacher --&gt; UC_Login\nTeacher --&gt; UC_LecAtt\nTeacher --&gt; UC_AttRpt\nTeacher --&gt; UC_Assign\nTeacher --&gt; UC_Quiz\nTeacher --&gt; UC_AIQuiz\nTeacher --&gt; UC_Exam\nTeacher --&gt; UC_Plag\nTeacher --&gt; UC_Analytics\nTeacher --&gt; UC_Comm\n\nStudent --&gt; UC_Login\nStudent --&gt; UC_Enroll\nStudent --&gt; UC_Assign\nStudent --&gt; UC_Quiz\nStudent --&gt; UC_Chatbot\nStudent --&gt; UC_Analytics\nStudent --&gt; UC_Fee\nStudent --&gt; UC_Comm\nStudent --&gt; UC_AttRpt\n\nAI --&gt; UC_Face\nAI --&gt; UC_Chatbot\nAI --&gt; UC_AIQuiz\nAI --&gt; UC_Plag\nAI --&gt; UC_Analytics\n\n&#39; --- Relationships ---\nUC_Login    .&gt; UC_Face      : &lt;&lt;extend&gt;&gt;\nUC_LecAtt    .&gt; UC_AttRpt    : &lt;&lt;include&gt;&gt;\nUC_GateScan  .&gt; UC_AttRpt    : &lt;&lt;include&gt;&gt;\nUC_AIQuiz    .&gt; UC_Quiz      : &lt;&lt;extend&gt;&gt;\nUC_Plag      .&gt; UC_Assign    : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="14pVjtuajESJFR7WagT--21">
