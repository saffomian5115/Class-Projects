        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam participant {\n  BackgroundColor #FFFDE7\n  BorderColor #D4A000\n  FontColor #000000\n  FontSize 11\n}\nskinparam sequence {\n  ArrowColor #000000\n  ArrowFontColor #000000\n  ArrowFontSize 10\n  LifeLineBorderColor #D4A000\n  LifeLineBackgroundColor #FFFDE7\n  GroupBackgroundColor #F5EEFF\n  GroupBorderColor #7C3AED\n}\nskinparam defaultFontName DM Sans\n\ntitle Fee Voucher Generation Flow\n\nparticipant \&quot;Admin\\n(Frontend)\&quot; as Admin  #D6E4FF\nparticipant \&quot;FastAPI\\n/vouchers/bulk\&quot; as API #C8F0DC\nparticipant \&quot;VoucherService\&quot; as Service    #FFFDE7\nparticipant \&quot;Database\&quot; as DB              #FFF9C4\n\n== Trigger Bulk Generation ==\nAdmin -&gt; API     : POST /vouchers/bulk\\n{ program_id, semester_id, due_date }\nAPI  -&gt; Service  : generate_bulk(data)\n\n== Fetch Active Students ==\nService -&gt; DB    : Query StudentProgramEnrollment\\n(program_id, status=active)\nDB --&gt; Service   : Active students list\n\n== Per Student Loop ==\nloop For each student\n  Service -&gt; DB  : Check existing unpaid\\nvoucher for semester\n  DB --&gt; Service : Result\n\n  alt Voucher already exists\n    Service -&gt; Service : Skip student\\nadd to skipped list\n\n  else No voucher\n    Service -&gt; DB  : Get FeeStructure\\n(program_id, current_semester)\n    DB --&gt; Service : Fee structure + amounts\n    Service -&gt; Service : Calculate total amount\\nGenerate unique voucher number\n    Service -&gt; DB  : Insert FeeVoucher record\n  end\nend\n\n== Return Summary ==\nService --&gt; API  : { generated, skipped }\nAPI --&gt; Admin    : 201 Created\\n{ generated_count, skipped_count }\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="14pVjtuajESJFR7WagT--21">
