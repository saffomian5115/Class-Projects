<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="T_Txx3Xaxb4ICrfqFrLV">
    <mxGraphModel dx="1717" dy="-63" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam actorStyle awesome\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EEFAF5\n  BorderColor #0D9488\n  FontColor #1A2235\n  FontSize 11\n}\nskinparam actor {\n  BackgroundColor #D0F5EC\n  BorderColor #0D9488\n  FontColor #1A2235\n  FontSize 12\n  FontStyle bold\n}\nskinparam package {\n  BackgroundColor #F5FDFB\n  BorderColor #6DD4C4\n  FontColor #1A2235\n  FontStyle bold\n}\nskinparam arrow {\n  Color #0D9488\n  FontColor #0D9488\n  FontSize 10\n}\n\nleft to right direction\n\n&#39; --- Actors ---\nactor \&quot;Student\&quot;             as Student #LightSalmon\nactor \&quot;Admin\&quot;               as Admin   #LightSteelBlue\nactor \&quot;Gemini AI Engine\&quot;    as Gemini  #Plum\nactor \&quot;FAISS RAG Engine\&quot;    as FAISS   #LightGoldenRodYellow\n\nrectangle \&quot;AI Chatbot Module\&quot; {\n\n  &#39; --- ROW 1: Management &amp; Interaction ---\n  package \&quot;FAQ Management (Admin)\&quot; as P1 {\n    usecase \&quot;Create FAQ\\nEntry\&quot; as UC_CreateFAQ\n    usecase \&quot;Update / Delete\\nFAQ Entry\&quot; as UC_EditFAQ\n    usecase \&quot;View All\\nFAQs\&quot; as UC_ViewFAQ\n  }\n\n  package \&quot;Chatbot Interaction (Student)\&quot; as P2 {\n    usecase \&quot;Send Message\\nto Chatbot\&quot; as UC_Send\n    usecase \&quot;Start / Resume\\nChat Session\&quot; as UC_Session\n    usecase \&quot;View Chat\\nHistory\&quot; as UC_History\n    usecase \&quot;Submit Session\\nFeedback &amp; Rating\&quot; as UC_Feedback\n    usecase \&quot;End Chat\\nSession\&quot; as UC_End\n  }\n\n  &#39; Side-by-side Row 1\n  P1 -right[hidden]- P2\n\n  &#39; --- ROW 2: Technical Pipeline ---\n  package \&quot;RAG Pipeline\&quot; as P3 {\n    usecase \&quot;Fetch Real-Time\\nStudent Data\&quot; as UC_FetchData\n    usecase \&quot;Search FAQs via\\nFAISS Similarity\&quot; as UC_FAISS\n    usecase \&quot;Build Context\\nfor Gemini\&quot; as UC_Context\n  }\n\n  package \&quot;Gemini Response Generation\&quot; as P4 {\n    usecase \&quot;Generate AI\\nResponse\&quot; as UC_Generate\n    usecase \&quot;Return Formatted\\nResponse to Student\&quot; as UC_Return\n    usecase \&quot;Save Message\\nto Database\&quot; as UC_Save\n  }\n\n  &#39; Alignment for Row 2\n  P1 -[hidden]down- P3\n  P3 -right[hidden]- P4\n}\n\n&#39; --- Associations ---\nStudent --&gt; UC_Send\nStudent --&gt; UC_Session\nStudent --&gt; UC_History\nStudent --&gt; UC_Feedback\nStudent --&gt; UC_End\n\nAdmin --&gt; UC_CreateFAQ\nAdmin --&gt; UC_EditFAQ\nAdmin --&gt; UC_ViewFAQ\n\nGemini --&gt; UC_Generate\nGemini --&gt; UC_Return\n\nFAISS --&gt; UC_FAISS\nFAISS --&gt; UC_Context\n\n&#39; --- Logic Flow (Include / Extend) ---\nUC_Send        .&gt; UC_Session    : &lt;&lt;include&gt;&gt;\nUC_Send        .&gt; UC_FetchData  : &lt;&lt;include&gt;&gt;\nUC_FetchData   .&gt; UC_FAISS      : &lt;&lt;include&gt;&gt;\nUC_FAISS       .&gt; UC_Context    : &lt;&lt;include&gt;&gt;\nUC_Context     .&gt; UC_Generate   : &lt;&lt;include&gt;&gt;\nUC_Generate    .&gt; UC_Return     : &lt;&lt;include&gt;&gt;\nUC_Return      .&gt; UC_Save       : &lt;&lt;include&gt;&gt;\nUC_End         .&gt; UC_Feedback   : &lt;&lt;extend&gt;&gt;\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="14pVjtuajESJFR7WagT--21">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1003" width="759" x="20" y="1100" as="geometry" />
