{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-client",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "problemMatcher": []
    },
    {
      "label": "start-server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": []
    },
    {
      "label": "start-all",
      "dependsOn": ["start-client", "start-server"],
      "dependsOrder": "parallel"
    }
  ]
}
